# Stow ignore patterns for .kilocode
# These files/directories should not be symlinked

# Configuration with secrets (use config.json.template instead)
^/cli/config\.json$

# History and logs (runtime data)
^/cli/history\.json$
^/cli/logs

# Workspaces (session-specific data)
^/cli/workspaces

# Tasks (runtime/cache data)
^/cli/global/tasks

# Secrets directory (if it exists)
^/cli/secrets

# Standard ignores
^/\.git
^/\.gitignore
^/README.*
^/LICENSE.*
