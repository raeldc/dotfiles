{
  "version": "1.0.0",
  "mode": "orchestrator",
  "telemetry": true,
  "provider": "default",
  "providers": [
    {
      "id": "default",
      "provider": "kilocode",
      "kilocodeToken": "YOUR_KILOCODE_TOKEN_HERE",
      "kilocodeModel": "anthropic/claude-sonnet-4.5",
      "kilocodePosthogApiKey": "YOUR_POSTHOG_API_KEY_HERE",
      "kilocodeOrganizationId": "YOUR_ORGANIZATION_ID_HERE"
    }
  ],
  "autoApproval": {
    "enabled": true,
    "read": {
      "enabled": true,
      "outside": false
    },
    "write": {
      "enabled": true,
      "outside": true,
      "protected": false
    },
    "browser": {
      "enabled": false
    },
    "retry": {
      "enabled": false,
      "delay": 10
    },
    "mcp": {
      "enabled": true
    },
    "mode": {
      "enabled": true
    },
    "subtasks": {
      "enabled": true
    },
    "execute": {
      "enabled": true,
      "allowed": [
        "ls",
        "cat",
        "echo",
        "pwd"
      ],
      "denied": [
        "rm -rf",
        "sudo rm",
        "mkfs",
        "dd if="
      ]
    },
    "question": {
      "enabled": false,
      "timeout": 60
    },
    "todo": {
      "enabled": true
    }
  },
  "theme": "dark",
  "customThemes": {}
}
