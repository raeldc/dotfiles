#!/usr/bin/env bash
# Save the current Herdr session state: workspaces, tabs, and panes (with
# names, cwd, agent status) plus the foreground process inside each pane.
# "Save herdr state" means run this script.
#
# Output: .local/herdr/herdr-state-<UTC timestamp>.json + .local/herdr/latest.json
# (gitignored and never stowed — machine-local state, not config).
# Must run inside a Herdr pane (HERDR_ENV=1).
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out_dir="$repo_dir/.local/herdr"

command -v herdr >/dev/null 2>&1 || { echo "herdr-snapshot: herdr not on PATH" >&2; exit 1; }
[ "${HERDR_ENV:-}" = 1 ] || { echo "herdr-snapshot: not inside Herdr (HERDR_ENV!=1)" >&2; exit 1; }

mkdir -p "$out_dir"
stamp="$(date -u +%Y%m%d-%H%M%S)"
herdr_version="$(herdr --version 2>/dev/null || echo unknown)"
raw="$(mktemp)"
trap 'rm -f "$raw"' EXIT

herdr api snapshot > "$raw"

python3 - "$raw" "$out_dir/herdr-state-$stamp.json" "$out_dir/latest.json" "$herdr_version" <<'PY'
import datetime
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser('~')


def read_json_prefix(path, max_lines=5, max_bytes=65536):
    """Read leading JSON objects (one per line) from a jsonl session file."""
    objs = []
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            for _ in range(max_lines):
                line = f.readline(max_bytes // max_lines)
                if not line:
                    break
                line = line.strip()
                if not line.startswith('{'):
                    continue
                try:
                    objs.append(json.loads(line))
                except Exception:
                    continue
    except OSError:
        pass
    return objs


def header_cwd_and_id(path):
    for o in read_json_prefix(path):
        if o.get('type') == 'session' and o.get('cwd'):
            return o.get('cwd'), o.get('id')
    return None, None


def jsonl_candidates_for_cwd(cwd, store, slug=None):
    """Ranked [(ref, argv, recency)] session files whose header cwd matches."""
    cands = []

    def consider(path):
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            return
        c, _ = header_cwd_and_id(path)
        if c == cwd:
            cands.append((path, mtime))

    if slug:
        d = os.path.join(store, slug)
        try:
            for e in os.listdir(d):
                if e.endswith('.jsonl'):
                    consider(os.path.join(d, e))
        except OSError:
            pass
    else:
        try:
            dirs = sorted(os.listdir(store))
        except OSError:
            dirs = []
        for dd in dirs[:500]:
            d = os.path.join(store, dd)
            if not os.path.isdir(d):
                continue
            try:
                files = [os.path.join(d, e) for e in os.listdir(d) if e.endswith('.jsonl')]
            except OSError:
                continue
            for p in files:
                consider(p)
    cands.sort(key=lambda t: t[1], reverse=True)
    return cands


def pi_slug(cwd):
    return '-' + cwd.replace('/', '-') + '--'


def normalize_title(t):
    t = (t or '').strip()
    t = re.sub(r'^(OC\s*\|\s*|✳\s*|π\s*[-–>]?\s*|\S+\s+>\s+)', '', t)
    t = re.sub(r'\.{3,}$', '', t).strip().lower()
    return t


def opencode_session_rows():
    try:
        out = subprocess.run(['opencode', 'session', 'list', '--format', 'json', '-n', '200'],
                             capture_output=True, text=True, timeout=60, check=True)
        items = json.loads(out.stdout)
        return [s for s in items if isinstance(s, dict) and s.get('id')]
    except Exception:
        return []


def bffs_roots():
    roots = []
    if os.environ.get('BFFS_HOME'):
        roots.append(os.path.expanduser(os.environ['BFFS_HOME']))
    roots.extend([
        os.path.join(HOME, 'Library', 'Application Support', 'bffs'),
        os.path.join(HOME, '.config', 'bffs'),
    ])
    return list(dict.fromkeys(roots))


def claude_runtime_for(process_info):
    """Resolve the exact BFFS account and Claude session from a live PID."""
    claude_pids = []
    for fp in process_info.get('foreground_processes', []):
        name = (fp.get('name') or '').lower()
        if 'claude' in name and fp.get('pid'):
            claude_pids.append(str(fp['pid']))
    for root in bffs_roots():
        sessions_root = os.path.join(root, 'sessions')
        try:
            accounts = os.listdir(sessions_root)
        except OSError:
            continue
        for account in accounts:
            for pid in claude_pids:
                runtime = os.path.join(sessions_root, account, 'sessions', f'{pid}.json')
                try:
                    with open(runtime, encoding='utf-8') as f:
                        meta = json.load(f)
                except (OSError, ValueError):
                    continue
                sid = meta.get('sessionId')
                if sid:
                    return {
                        'session_ref': sid,
                        'resume_argv': ['--resume', sid],
                        'environment': {'BFFS_ACCOUNT': account},
                        'confidence': 'bffs-live-pid',
                        'bffs_account': account,
                        'bffs_runtime': runtime,
                        'bridge_session_id': meta.get('bridgeSessionId'),
                    }
    return None


def candidates_for(kind, cwd, title, oc_rows):
    """Ranked [(ref, resume_argv, match_kind)] for one agent pane.

    Claude is handled separately from BFFS's live-PID metadata. Guessing from
    history is not safe when several account-specific transcript stores exist.
    """
    if kind == 'pi':
        return [(p, ['--session', p], 'file') for p, _ in
                jsonl_candidates_for_cwd(cwd, os.path.join(HOME, '.pi/agent/sessions'), pi_slug(cwd))]
    if kind == 'omp':
        return [(p, ['-r', p], 'file') for p, _ in
                jsonl_candidates_for_cwd(cwd, os.path.join(HOME, '.omp/agent/sessions'))]
    if kind == 'opencode':
        rows = [s for s in oc_rows if s.get('directory') == cwd]
        rows.sort(key=lambda s: s.get('updated', 0), reverse=True)
        return [(s['id'], ['-s', s['id']], 'session') for s in rows]
    return []


def resolve_agent_sessions(agents, processes):
    """Best-effort pane -> agent-session mapping for resume on restore.

    Panes sharing (kind, cwd) split the ranked candidates by recency so two
    panes never resume the same session; leftovers restart fresh.
    """
    out = {}
    oc_rows = opencode_session_rows()
    groups = {}
    for a in agents:
        if a.get('pane_id') and a.get('agent'):
            groups.setdefault((a.get('agent'), a.get('cwd')), []).append(a)
    for (kind, cwd), group in groups.items():
        group.sort(key=lambda a: (a.get('state_change_seq') or 0, a.get('revision') or 0),
                   reverse=True)
        pool = candidates_for(kind, cwd, None, oc_rows)
        pool = [list(c) for c in pool]
        for a in group:
            pane_id = a.get('pane_id')
            entry = {'kind': kind, 'cwd': cwd, 'title': a.get('terminal_title_stripped'),
                     'session_ref': None, 'resume_argv': [], 'environment': {},
                     'confidence': None}
            try:
                if kind == 'claude':
                    runtime = claude_runtime_for(processes.get(pane_id, {}))
                    if runtime:
                        entry.update(runtime)
                    out[pane_id] = entry
                    continue
                # title match first (opencode titles survive verbatim)
                nt = normalize_title(a.get('terminal_title_stripped'))
                hit = None
                if kind == 'opencode' and nt:
                    for i, (ref, argv, how) in enumerate(pool):
                        row = next((s for s in oc_rows if s.get('id') == ref), {})
                        st = normalize_title(row.get('title'))
                        if st and (st in nt or nt in st):
                            hit = i
                            break
                if hit is None and pool:
                    hit = 0
                if hit is not None:
                    ref, argv, how = pool.pop(hit)
                    entry.update(session_ref=ref, resume_argv=argv, confidence=f'cwd+{how}')
            except Exception as e:
                entry['error'] = str(e)
            out[pane_id] = entry
    return out

raw_path, stamped_path, latest_path, herdr_version = sys.argv[1:5]

with open(raw_path, encoding='utf-8') as f:
    snapshot_doc = json.load(f)

result = snapshot_doc.get('result', {})
snap = result.get('snapshot', result)
panes = snap.get('panes', [])

processes = {}
for pane in panes:
    pane_id = pane.get('pane_id')
    if not pane_id:
        continue
    try:
        out = subprocess.run(
            ['herdr', 'pane', 'process-info', '--pane', pane_id],
            capture_output=True, text=True, timeout=30, check=True,
        )
        processes[pane_id] = json.loads(out.stdout)['result']['process_info']
    except Exception as e:  # keep the snapshot even if one pane is unreadable
        processes[pane_id] = {'pane_id': pane_id, 'error': str(e)}

doc = {
    'taken_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'herdr_version': herdr_version,
    'snapshot': snapshot_doc,
    'process_info_by_pane': processes,
    'agent_sessions': resolve_agent_sessions(snap.get('agents', []), processes),
}

for path in (stamped_path, latest_path):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(doc, f, indent=2)
        f.write('\n')

ws = snap.get('workspaces', [])
tabs = snap.get('tabs', [])
nsess = sum(1 for v in doc['agent_sessions'].values() if v.get('session_ref'))
print(f'herdr-snapshot: {len(ws)} workspaces, {len(tabs)} tabs, '
      f'{len(panes)} panes, {nsess} agent sessions -> {stamped_path}')
PY
