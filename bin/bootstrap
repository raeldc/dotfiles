#!/usr/bin/env bash
# Greenfield machine bootstrap: brew packages, node + npm globals,
# standalone tools, and dotfile symlinks. Safe to re-run (idempotent).
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
os="$(uname -s)"

step() { printf '\n==> %s\n' "$*"; }

# Greenfield guard: bootstrap needs brew (manifests) and expects the OS-level
# prereqs done first. See "Greenfield runbook" in activities/0000-activity-baseline.md.
if ! command -v brew >/dev/null 2>&1; then
  cat >&2 <<'EOF'
brew not found on PATH. Finish the OS prerequisites first (Linux):
  sudo apt-get install -y build-essential procps curl file git unzip
  sudo install -d -o "$USER" -g "$(id -gn)" -m 0755 /home/linuxbrew
  nohup env NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" > /tmp/brew-install.log 2>&1 &
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
Then re-run bin/bootstrap.
EOF
  exit 1
fi

step "Homebrew packages (taps + formulae)"
"$repo_dir/bin/brew-install" --taps
"$repo_dir/bin/brew-install" --formulae

if [[ "$os" == "Darwin" ]]; then
  step "Homebrew casks"
  "$repo_dir/bin/brew-install" --casks
fi

if [[ "$os" == "Linux" ]]; then
  step "Podman Machine helper"
  "$repo_dir/bin/gvproxy-install"
fi

step "Node + npm globals"
"$repo_dir/bin/npm-install"

step "Bun"
if [ ! -x "$HOME/.bun/bin/bun" ]; then
  curl -fsSL https://bun.sh/install | bash
else
  echo "bun already installed at ~/.bun"
fi

step "Plannotator"
if ! command -v plannotator >/dev/null 2>&1; then
  # bash, not sh: the installer uses bashisms and dash (Ubuntu sh) chokes.
  curl -fsSL https://plannotator.ai/install.sh | bash
else
  echo "plannotator already installed"
fi

step "Stow dotfiles (no folding)"
mkdir -p "$HOME/.config" "$HOME/.pi/agent"
stow --no-folding --dir="$repo_dir" --target="$HOME" .

if command -v herdr >/dev/null 2>&1 && [ -x "$repo_dir/bin/herdr-config" ]; then
  step "Rendering herdr config (template + this machine's theme)"
  "$repo_dir/bin/herdr-config" || echo "herdr-config failed — see above" >&2
fi

if command -v podman >/dev/null 2>&1; then
  step "Setting up Podman Machine"
  "$repo_dir/bin/podman-setup"
fi

if [ -x "$repo_dir/bin/activities" ]; then
  step "Running deterministic activities"
  DOTFILES_AGENT=bootstrap "$repo_dir/bin/activities" run || echo "some activities failed — see above" >&2
  pending="$("$repo_dir/bin/activities" list --pending | wc -l | tr -d ' ')"
  if [ "$pending" != "0" ]; then
    echo "$pending activity(ies) pending — review with: bin/activities list --pending"
  fi
fi

cat <<'EOF'

Bootstrap complete. Remaining manual/interactive steps — see docs/setup/manual.md:
  1. SSH key + GitHub access (ssh-add, ssh config alias if used)
  2. Editor/agent logins: pi auth, opencode, codex, etc.
  3. Secrets: ~/.dotfiles/.env and ~/.local/bin/env
EOF
