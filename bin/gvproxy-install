#!/usr/bin/env bash
set -euo pipefail

[[ "$(uname -s)" == "Linux" ]] || exit 0

version="0.8.9"
install_dir="${GVPROXY_INSTALL_DIR:-/usr/local/libexec/podman}"
destination="$install_dir/gvproxy"

case "$(uname -m)" in
  x86_64)
    asset="gvproxy-linux-amd64"
    checksum="3011c5629c9138d2050fb23c510e09ae53e30ec52e6a9ab85632bc1550e8ef63"
    ;;
  aarch64|arm64)
    asset="gvproxy-linux-arm64"
    checksum="6ecca02839254c9a0cc184bba7aac63755a22d7ed10d455b852528a99d7f7d4b"
    ;;
  *)
    echo "Unsupported gvproxy architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

if [[ -x "$destination" ]] && "$destination" --version 2>/dev/null | grep -Fq "v$version"; then
  echo "gvproxy v$version already installed"
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
curl -fsSL -o "$tmp" "https://github.com/containers/gvisor-tap-vsock/releases/download/v$version/$asset"
printf '%s  %s\n' "$checksum" "$tmp" | sha256sum -c - >/dev/null

if [[ $EUID -eq 0 || -w "$install_dir" ]] || { [[ ! -e "$install_dir" ]] && [[ -w "$(dirname "$install_dir")" ]]; }; then
  install -d -m 0755 "$install_dir"
  install -m 0755 "$tmp" "$destination"
else
  sudo install -d -m 0755 "$install_dir"
  sudo install -m 0755 "$tmp" "$destination"
fi

echo "Installed gvproxy v$version at $destination"
