#!/usr/bin/env bash
# Sync this machine with the dotfiles repo: pull, restow, reapply manifests.
# Run this on any machine after changes are committed and pushed from another.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
os="$(uname -s)"

step() { printf '\n==> %s\n' "$*"; }

step "Checking repo state"
if ! git -C "$repo_dir" diff --quiet || ! git -C "$repo_dir" diff --cached --quiet; then
  echo "Uncommitted changes in $repo_dir — commit and push them first:" >&2
  git -C "$repo_dir" status --short >&2
  exit 1
fi

step "Pulling latest"
git -C "$repo_dir" pull --ff-only

step "Restowing dotfiles"
# Greenfield: stow comes from the brew manifest, which runs below — install it
# on demand so first-time syncs work. Without brew too, this is a pre-runbook
# machine: point at the greenfield runbook.
if ! command -v stow >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew install stow
  else
    echo "stow (and brew) missing — greenfield machine? Follow activities/0000-activity-baseline.md first" >&2
    exit 1
  fi
fi
mkdir -p "$HOME/.config" "$HOME/.pi/agent"
restow_output="$(stow --no-folding --restow --dir="$repo_dir" --target="$HOME" . 2>&1)" || {
  # Local real files blocking stow (tools like pi rewrite configs in place,
  # replacing symlinks). Back them up and let the repo version win.
  # Only the "real file where a symlink belongs" conflict is auto-resolved
  # (this is what pi/config-rewriting tools cause). Other conflict shapes
  # (target owned by another package, etc.) yield no matches and fall through
  # to the hard error below.
  conflicts="$(printf '%s\n' "$restow_output" | sed -n 's/.*over existing target \([^ ]*\).*/\1/p')"
  if [ -z "$conflicts" ]; then
    printf '%s\n' "$restow_output" >&2
    exit 1
  fi
  backup_dir="$HOME/.local/share/dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if cmp -s "$HOME/$rel" "$repo_dir/$rel"; then
      echo "identical to repo, relinking: $rel"
    else
      echo "differs from repo, backed up: $rel -> $backup_dir/$rel"
      mkdir -p "$backup_dir/$(dirname "$rel")"
      # -a preserves mode/times and copies dirs/symlinks intact
      cp -a "$HOME/$rel" "$backup_dir/$rel"
    fi
    rm -rf "$HOME/${rel:?}"
  done <<< "$conflicts"
  stow --no-folding --restow --dir="$repo_dir" --target="$HOME" .
}

if command -v herdr >/dev/null 2>&1 && [ -x "$repo_dir/bin/herdr-config" ]; then
  step "Rendering herdr config (template + this machine's theme)"
  "$repo_dir/bin/herdr-config" || echo "herdr-config failed — see above" >&2
fi

step "Applying Homebrew manifest"
"$repo_dir/bin/brew-install" --taps
"$repo_dir/bin/brew-install" --formulae
if [[ "$os" == "Darwin" ]]; then
  "$repo_dir/bin/brew-install" --casks
fi

if command -v podman >/dev/null 2>&1; then
  step "Setting up Podman"
  "$repo_dir/bin/podman-setup"
fi

step "Applying npm manifest"
"$repo_dir/bin/npm-install"

if [ -x "$repo_dir/bin/activities" ]; then
  step "Running deterministic activities"
  # Don't let one failing activity abort the whole sync (manifests are already
  # applied by this point); surface it and continue to the pending report.
  DOTFILES_AGENT=sync "$repo_dir/bin/activities" run || echo "some activities failed — see above" >&2
  pending="$("$repo_dir/bin/activities" list --pending | wc -l | tr -d ' ')"
  if [ "$pending" != "0" ]; then
    echo "$pending activity(ies) pending — review with: bin/activities list --pending"
  fi
fi

# shellcheck disable=SC2016
printf '\nSync complete. Reload the shell: exec $SHELL\n'
