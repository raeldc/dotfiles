#!/usr/bin/env bash
set -euo pipefail

manifest_path="${BREW_MANIFEST:-$HOME/.dotfiles/manifests/homebrew.json}"

usage() {
  cat <<'EOF'
Usage: brew-install [--taps] [--formulae] [--casks] [--all] [--manifest PATH]

Options:
  --taps       Install Homebrew taps from the manifest
  --formulae   Install formulae from the manifest
  --casks      Install casks from the manifest (macOS only)
  --all        Install taps, formulae, and casks
  --manifest   Override manifest path (default: $HOME/.dotfiles/manifests/homebrew.json)
EOF
}

if [[ ${1:-} == "" ]]; then
  usage
  exit 1
fi

if ! command -v brew >/dev/null; then
  echo "brew not found on PATH" >&2
  exit 1
fi

if ! command -v python3 >/dev/null; then
  echo "python3 not found on PATH" >&2
  exit 1
fi

if [[ ! -f "$manifest_path" ]]; then
  echo "Manifest not found: $manifest_path" >&2
  exit 1
fi

read_manifest() {
  python3 - "$manifest_path" "$1" "$(uname -s)" <<'PY'
import json
import sys

path = sys.argv[1]
key = sys.argv[2]
platform = {"Darwin": "mac", "Linux": "linux"}.get(sys.argv[3], "")
with open(path, "r", encoding="utf-8") as handle:
  data = json.load(handle)

value = data.get(key, [])
if isinstance(value, dict):
  # Platform-split schema: {global: [...], mac: [...], linux: [...]}
  items = list(value.get("global", []))
  if platform:
    items += list(value.get(platform, []))
else:
  # Flat list (backward compatible)
  items = value

for item in items:
  print(item)
PY
}

# Exact-match membership test against a newline-separated list
list_contains() {
  case "
$1
" in *"
$2
"*) return 0 ;; *) return 1 ;; esac
}

install_taps() {
  local taps=()
  while IFS= read -r line; do
    taps+=("$line")
  done < <(read_manifest taps)
  if [[ ${#taps[@]} -eq 0 ]]; then
    return 0
  fi
  for tap in "${taps[@]}"; do
    brew tap "$tap"
    # Newer Homebrew refuses to load untrusted third-party taps; trusting here
    # is the explicit opt-in from listing the tap in the manifest.
    if brew help trust >/dev/null 2>&1; then
      brew trust --tap "$tap" >/dev/null 2>&1 || true
    fi
  done
}

install_formulae() {
  local formulae=() line
  local installed
  installed="$(brew list --formula --full-name 2>/dev/null || true)"
  while IFS= read -r line; do
    # Skip already-installed: keeps re-runs quiet and avoids surprise upgrades
    list_contains "$installed" "$line" && continue
    formulae+=("$line")
  done < <(read_manifest formulae)
  if [[ ${#formulae[@]} -eq 0 ]]; then
    return 0
  fi
  brew install "${formulae[@]}"
}

install_casks() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "Skipping casks: macOS only" >&2
    return 0
  fi
  local casks=() line
  local installed
  installed="$(brew list --cask 2>/dev/null || true)"
  while IFS= read -r line; do
    list_contains "$installed" "$line" && continue
    casks+=("$line")
  done < <(read_manifest casks)
  if [[ ${#casks[@]} -eq 0 ]]; then
    return 0
  fi
  brew install --cask "${casks[@]}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --taps)
      install_taps
      ;;
    --formulae)
      install_formulae
      ;;
    --casks)
      install_casks
      ;;
    --all)
      install_taps
      install_formulae
      install_casks
      ;;
    --manifest)
      manifest_path="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
  shift
done
