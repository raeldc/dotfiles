#!/usr/bin/env bash
set -euo pipefail

if ! command -v podman >/dev/null 2>&1; then
  echo "podman is not installed" >&2
  exit 1
fi

if [[ "$(uname -s)" == "Linux" ]]; then
  if ! command -v newuidmap >/dev/null 2>&1 || ! command -v newgidmap >/dev/null 2>&1; then
    echo "rootless podman needs newuidmap/newgidmap (uidmap package). Run: sudo apt-get install -y uidmap" >&2
    exit 1
  fi
  brew services start podman >/dev/null
  socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
  for _ in {1..50}; do
    [[ -S "$socket" ]] && break
    sleep 0.1
  done
  [[ -S "$socket" ]] || { echo "Podman API socket failed to start: $socket" >&2; exit 1; }
  echo "Podman native API: $socket"
  exit 0
fi

machine="${PODMAN_MACHINE:-podman-machine-default}"
podman machine inspect "$machine" >/dev/null 2>&1 || podman machine init "$machine"
[[ "$(podman machine inspect --format '{{.State}}' "$machine")" == "running" ]] || podman machine start "$machine"
podman machine inspect --format '{{.Name}}: {{.State}}' "$machine"
