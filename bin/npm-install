#!/usr/bin/env bash
# Install pinned node (via nvm) and global npm packages from manifests/npm.json
set -euo pipefail

manifest_path="${NPM_MANIFEST:-$HOME/.dotfiles/manifests/npm.json}"

# Locate nvm.sh: hand-linked ~/.nvm, or Homebrew's opt tree (mac/linux).
find_nvm_sh() {
  local prefix cand
  prefix="$(brew --prefix 2>/dev/null || true)"
  for cand in \
    "$HOME/.nvm/nvm.sh" \
    "${HOMEBREW_PREFIX:-}/opt/nvm/nvm.sh" \
    "${prefix:+$prefix/opt/nvm/nvm.sh}" \
    /opt/homebrew/opt/nvm/nvm.sh \
    /usr/local/opt/nvm/nvm.sh \
    /home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh; do
    if [ -n "$cand" ] && [ -s "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

nvm_sh="$(find_nvm_sh || true)"

if ! command -v node >/dev/null && [ -z "$nvm_sh" ]; then
  echo "node not found and nvm.sh not found" >&2
  echo "run: brew install nvm (or bin/bootstrap)" >&2
  exit 1
fi

if [ ! -f "$manifest_path" ]; then
  echo "Manifest not found: $manifest_path" >&2
  exit 1
fi

# shellcheck source=/dev/null
[ -n "$nvm_sh" ] && . "$nvm_sh"

read_manifest() {
  python3 - "$manifest_path" "$1" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
  data = json.load(handle)
value = data.get(sys.argv[2])
if value is not None:
  print(value)
PY
}

node_version="$(read_manifest node)"

if [ -n "${node_version:-}" ]; then
  if [ "$(node --version 2>/dev/null | sed 's/^v//')" != "$node_version" ]; then
    nvm install "$node_version"
    nvm alias default "$node_version"
  else
    echo "node $node_version already active"
  fi
fi

packages=()
while IFS= read -r line; do
  packages+=("$line")
done < <(python3 - "$manifest_path" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as handle:
  for item in json.load(handle).get("packages", []):
    print(item)
PY
)

if [[ ${#packages[@]} -eq 0 ]]; then
  echo "No packages in manifest"
  exit 0
fi

# Skip packages already present so re-runs are fast (delta, not a stored pointer:
# checks reality each time, so it self-heals if a package was removed). A global
# package "name" lives at "$(npm root -g)/name" ("@scope/name" for scoped ones).
# Manifest entries carry no @version, so the bare name is the directory name.
# To force upgrades, run `npm update -g` (or `npm install -g <pkg>`) directly.
npm_root="$(npm root -g 2>/dev/null || true)"
to_install=()
for pkg in "${packages[@]}"; do
  if [ -n "$npm_root" ] && [ -d "$npm_root/$pkg" ]; then
    continue
  fi
  to_install+=("$pkg")
done

if [[ ${#to_install[@]} -eq 0 ]]; then
  echo "All npm globals present (${#packages[@]} in manifest)"
  exit 0
fi

echo "Installing ${#to_install[@]} missing npm global(s): ${to_install[*]}"
npm install -g "${to_install[@]}"
