#!/usr/bin/env bash
# Launch a remote herdr with a distinct, auto-assigned theme so each remote is
# visually distinguishable from the local instance and from other remotes.
#
# herdr loads its config from $HERDR_CONFIG_PATH when set. We derive a themed
# copy of the shared, stowed config on every launch — only the [theme] name is
# overridden — so edits to the base always carry through (DRY, no duplication)
# and nothing machine-specific has to live in the committed config.
#
# The theme is chosen deterministically from the target, so a given box always
# gets the same colour with no hand-maintained alias per remote. Pass a second
# argument to force a specific theme.
#
# Usage: herdr-remote <target> [theme]
#   target: ssh target; a bare host gets $USER@ prepended (birdbox -> rael@birdbox)
set -euo pipefail

usage() { echo "usage: herdr-remote <target> [theme]" >&2; exit 1; }

target="${1:-}"
[ -n "$target" ] || usage
case "$target" in
  *@*) ;;                                    # already user@host
  *) target="${USER:-$(id -un)}@$target" ;;  # bare host -> user@host
esac

# Remote theme pool: built-in themes minus tokyo-night (the local default) and
# "terminal" (mirrors host colours, too close to local to read as distinct).
themes=(catppuccin dracula nord gruvbox one-dark solarized kanagawa rose-pine vesper)
theme="${2:-}"
if [ -z "$theme" ]; then
  # Deterministic pick from the (normalised) target so a box is always the same colour.
  idx=$(( $(printf '%s' "$target" | cksum | cut -d' ' -f1) % ${#themes[@]} ))
  theme="${themes[$idx]}"
fi

base="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr"
mkdir -p "$state_dir"
slug="$(printf '%s' "$target" | tr -c 'A-Za-z0-9._-' '_')"
gen="$state_dir/remote-$slug.toml"

if [ -f "$base" ]; then
  # Replace `name = "..."` only inside the [theme] section (up to the next
  # [section] header). Other `name`-suffixed keys (dark_name, rename_tab, ...)
  # do not start with `name` and are left untouched.
  sed -E '/^\[theme\]/,/^\[/ s/^[[:space:]]*name[[:space:]]*=[[:space:]]*".*"/name = "'"$theme"'"/' \
    "$base" > "$gen"
else
  printf '[theme]\nname = "%s"\n' "$theme" > "$gen"
fi

echo "herdr-remote: $target (theme: $theme)" >&2
exec env HERDR_CONFIG_PATH="$gen" herdr --remote "$target" --remote-keybindings server
