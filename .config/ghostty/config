font-family = "CaskaydiaMono Nerd Font Mono"
font-size = 15
macos-option-as-alt = true

theme = deepsea

background-opacity = 1

# Terminal-level split creation and tab navigation
keybind = alt+shift+h=unbind
keybind = alt+shift+l=unbind
keybind = alt+shift+"=new_split:down
keybind = alt+shift+%=new_split:right
keybind = alt+shift+bracket_left=previous_tab
keybind = alt+shift+bracket_right=next_tab
keybind = ctrl+shift+z=toggle_split_zoom
