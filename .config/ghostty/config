font-family = "CaskaydiaMono Nerd Font Mono"
font-size = 15
macos-option-as-alt = true

theme = deepsea

background-opacity = 1

# Match WezTerm-style pane and tab navigation
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+shift+j=new_split:down
keybind = alt+shift+l=new_split:right
keybind = alt+shift+"=new_split:down
keybind = alt+shift+%=new_split:right
keybind = alt+shift+bracket_left=previous_tab
keybind = alt+shift+bracket_right=next_tab
keybind = ctrl+shift+z=toggle_split_zoom
